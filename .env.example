# AdsPower Local API key (AdsPower: Account Management > Settings > Local API > Generate api-key)
ADSPOWER_API_KEY=
# Instagram Graph API: long-lived user token of a Facebook Page linked to an Instagram professional
# account (docs/RUNBOOK.md, section 0). Used when trends.source = "graph".
INSTAGRAM_GRAPH_TOKEN=
# Only when trends.source = "apify"
APIFY_TOKEN=
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric user ids allowed to use the bot and receive alerts
TELEGRAM_OPERATOR_IDS=
NOTION_TOKEN=
NOTION_PUBLICATIONS_DB=
NOTION_ACCOUNTS_DB=
# Claude API key (console.anthropic.com): picks moments and writes hooks for clipping campaigns with
# source = "video" (clips/vod.py), a few cents per video
ANTHROPIC_API_KEY=
